# Copier ce fichier en ".env" puis compléter les valeurs.
# Ce fichier .env contient des secrets : il ne doit jamais être commité.
NODE_ENV=development
PORT=3000

# Connexion à PostgreSQL, au format :
#   postgres://bazardim:<POSTGRES_PASSWORD>@localhost:5432/<nom de la base>
# en reprenant le mot de passe choisi dans le fichier .env à la racine du projet.
DATABASE_URL=
# Base utilisée par les tests automatiques (vidée à chaque test) : bazardim_test.
TEST_DATABASE_URL=

# Clé secrète qui signe les jetons de connexion. Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

FRONT_URL=http://localhost:5173

# Mot de passe des comptes de démonstration créés par `npm run db:reset` (8 caractères minimum).
# Il sert à se connecter en local, par exemple avec collectionneurdu92@example.com ou admin@example.com.
SEED_DEMO_PASSWORD=

# Paiement Stripe (mode TEST uniquement) : tableau de bord Stripe → Développeurs → Clés API.
# Clé SECRÈTE (sk_test_...) : elle ne doit jamais quitter le back-end ni être commitée.
STRIPE_SECRET_KEY=
# Secret du webhook (whsec_...), affiché par la commande `stripe listen` (voir back/README.md).
# Facultatif en local : sans lui, le paiement est vérifié à l'affichage de la page de confirmation.
STRIPE_WEBHOOK_SECRET=
